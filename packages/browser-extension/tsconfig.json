{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@blockingmachine/core/element-ai": ["../core/src/ai/elementClassifier.ts"],
      "@blockingmachine/core/domain-ai": ["../core/src/ai/MiniAiClassifier.ts"],
      "@blockingmachine/core/ruleHost": ["../core/src/ruleHost.ts"],
      "@blockingmachine/core/entropy": ["../core/src/ai/entropy.ts"]
    },
    "types": ["chrome"]
  },
  "include": ["src/**/*"]
}
