{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@blockingmachine/core/element-ai": ["../core/src/ai/elementClassifier.ts"],
      "@blockingmachine/core/domain-ai": ["../core/src/ai/MiniAiClassifier.ts"]
    }
  },
  "include": ["src/**/*"]
}
