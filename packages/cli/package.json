{
  "name": "@blockingmachine/cli",
  "version": "1.0.0-rc.4",
  "description": "Production command-line interface for automated filter list compilation, local feed serving, diffing, and DNS diagnostics.",
  "author": {
    "name": "Greigh Studios LLC",
    "email": "daniel@greighstudios.com",
    "url": "https://greighstudios.com"
  },
  "homepage": "https://github.com/greigh/Blockingmachine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greigh/Blockingmachine.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/greigh/Blockingmachine/issues"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --skipLibCheck && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "tsc -w",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@blockingmachine/core": "^1.0.0-rc.4",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "dotenv": "^18.0.3",
    "mongoose": "^9.10.2",
    "node-fetch": "^3.3.2",
    "progress": "^2.0.3",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/progress": "^2.0.7",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.13",
    "typescript": "~5.8.3"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "greigh",
      "repo": "Blockingmachine"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./export": "./dist/lib/export.js"
  },
  "bin": {
    "blockingmachine": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "scope": "@blockingmachine"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
