{
  "name": "@blockingmachine/core",
  "version": "1.0.0-rc.6",
  "description": "Core rule parsing, deduplication, format export, and embedded Mini-AI classification engine for Blockingmachine.",
  "type": "module",
  "author": {
    "name": "Greigh Studios LLC",
    "email": "daniel@greighstudios.com",
    "url": "https://greighstudios.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.js",
      "require": "./dist/sources.js"
    },
    "./package.json": "./package.json"
  },
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc --skipLibCheck",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "adguard",
    "filtering",
    "blocking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greigh/Blockingmachine.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/greigh/Blockingmachine/issues"
  },
  "homepage": "https://github.com/greigh/Blockingmachine#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "node-fetch": "^3.3.2",
    "progress": "^2.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/progress": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "scope": "@blockingmachine"
  }
}
