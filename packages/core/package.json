{
  "name": "@blockingmachine/core",
  "version": "1.0.0-rc.11",
  "description": "Core rule parsing, deduplication, format export, and embedded Mini-AI classification engine for Blockingmachine.",
  "type": "module",
  "author": {
    "name": "Greigh Studios LLC",
    "email": "daniel@greighstudios.com",
    "url": "https://greighstudios.com"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.js",
      "require": "./dist/sources.js"
    },
    "./element-ai": {
      "types": "./dist/ai/elementClassifier.d.ts",
      "import": "./dist/ai/elementClassifier.js",
      "require": "./dist/ai/elementClassifier.js"
    },
    "./element-harvest": {
      "types": "./dist/ai/elementCorpusHarvest.d.ts",
      "import": "./dist/ai/elementCorpusHarvest.js",
      "require": "./dist/ai/elementCorpusHarvest.js"
    },
    "./package.json": "./package.json",
    "./domain-evaluator": {
      "types": "./dist/ai/domainEvaluator.d.ts",
      "import": "./dist/ai/domainEvaluator.js",
      "require": "./dist/ai/domainEvaluator.js"
    },
    "./ruleHost": {
      "types": "./dist/ruleHost.d.ts",
      "import": "./dist/ruleHost.js",
      "require": "./dist/ruleHost.js"
    },
    "./tiers": {
      "types": "./dist/tiers.d.ts",
      "import": "./dist/tiers.js",
      "require": "./dist/tiers.js"
    },
    "./tier-plan": {
      "types": "./dist/tierPlanInput.d.ts",
      "import": "./dist/tierPlanInput.js",
      "require": "./dist/tierPlanInput.js"
    }
  },
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc --skipLibCheck && node -e \"const fs=require('fs'),p=require('path');const src=p.join('src','ai','db'),dest=p.join('dist','ai','db');fs.mkdirSync(dest,{recursive:true});for(const f of ['manifest.json','remote-patch.json','patch-schema.json','db-schema.json']){fs.copyFileSync(p.join(src,f),p.join(dest,f));}\"",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src/ai/db",
    "ai-weights",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "adguard",
    "filtering",
    "blocking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greigh/Blockingmachine.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/greigh/Blockingmachine/issues"
  },
  "homepage": "https://github.com/greigh/Blockingmachine#readme",
  "dependencies": {
    "chalk": "^6.0.1",
    "node-fetch": "^3.3.2",
    "progress": "^2.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/progress": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "scope": "@blockingmachine"
  }
}
