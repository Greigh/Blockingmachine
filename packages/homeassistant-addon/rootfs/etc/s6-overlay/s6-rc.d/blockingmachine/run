#!/usr/bin/with-contenv bash
set -e

echo "[Blockingmachine Add-on] Starting Blockingmachine Hub & Feed Server..."

OPTIONS_FILE="/data/options.json"
FEED_PORT=9191
FEED_TOKEN=""
FEED_SOURCE_URL=""
FEED_SOURCE_TOKEN=""
AUTO_COMPILE="24h"
ENABLE_AI=true
HTTPS_FILTER=true
HTTPS_DATA_PORT=9294
HTTPS_DATA_TOKEN=""
DNS_FILTER=false
DNS_PORT=53
DNS_UPSTREAM="https://dns.quad9.net/dns-query"
LOG_LEVEL="info"

if [ -f "$OPTIONS_FILE" ]; then
    FEED_PORT=$(jq -r '.feed_port // 9191' "$OPTIONS_FILE")
    FEED_TOKEN=$(jq -r '.feed_token // ""' "$OPTIONS_FILE")
    FEED_SOURCE_URL=$(jq -r '.feed_source_url // ""' "$OPTIONS_FILE")
    FEED_SOURCE_TOKEN=$(jq -r '.feed_source_token // ""' "$OPTIONS_FILE")
    AUTO_COMPILE=$(jq -r '.auto_compile_interval // "24h"' "$OPTIONS_FILE")
    ENABLE_AI=$(jq -r '.enable_ai_radar // true' "$OPTIONS_FILE")
    HTTPS_FILTER=$(jq -r '.https_filter // true' "$OPTIONS_FILE")
    HTTPS_DATA_PORT=$(jq -r '.https_data_port // 9294' "$OPTIONS_FILE")
    HTTPS_DATA_TOKEN=$(jq -r '.https_data_token // ""' "$OPTIONS_FILE")
    DNS_FILTER=$(jq -r '.dns_filter // false' "$OPTIONS_FILE")
    DNS_PORT=$(jq -r '.dns_port // 53' "$OPTIONS_FILE")
    DNS_UPSTREAM=$(jq -r '.dns_upstream // "https://dns.quad9.net/dns-query"' "$OPTIONS_FILE")
    LOG_LEVEL=$(jq -r '.log_level // "info"' "$OPTIONS_FILE")
fi

export FEED_PORT="$FEED_PORT"
export FEED_TOKEN="$FEED_TOKEN"
export FEED_SOURCE_URL="$FEED_SOURCE_URL"
export FEED_SOURCE_TOKEN="$FEED_SOURCE_TOKEN"
export AUTO_COMPILE="$AUTO_COMPILE"
export ENABLE_AI="$ENABLE_AI"
export HTTPS_FILTER="$HTTPS_FILTER"
export HTTPS_DATA_PORT="$HTTPS_DATA_PORT"
export HTTPS_DATA_TOKEN="$HTTPS_DATA_TOKEN"
export DNS_FILTER="$DNS_FILTER"
export DNS_PORT="$DNS_PORT"
export DNS_UPSTREAM="$DNS_UPSTREAM"
export LOG_LEVEL="$LOG_LEVEL"
export DATA_DIR="/data/blockingmachine"

mkdir -p "$DATA_DIR"

echo "[Blockingmachine Add-on] Initialized on port $FEED_PORT with $AUTO_COMPILE compilation schedule."
if [ -n "$FEED_TOKEN" ]; then
    echo "[Blockingmachine Add-on] Feed token is set — every endpoint requires it."
else
    echo "[Blockingmachine Add-on] No feed_token option — the server resolves its LAN posture on first boot"
    echo "  (new installs get a generated token in \$DATA_DIR/.feed_token; existing installs keep open mode)."
fi
if [ -n "$FEED_SOURCE_URL" ]; then
    echo "[Blockingmachine Add-on] Compiles will sync feeds from $FEED_SOURCE_URL"
fi
echo "[Blockingmachine Add-on] Dedicated endpoints available:"
echo "  - DNS feed: http://homeassistant.local:$FEED_PORT/dns.txt"
echo "  - Browser feed: http://homeassistant.local:$FEED_PORT/browser.txt"
echo "  - REST API: http://homeassistant.local:$FEED_PORT/v1/status"
if [ "$HTTPS_FILTER" = "true" ]; then
    echo "  - HTTPS filter proxy: homeassistant.local:$HTTPS_DATA_PORT (PAC at :$HTTPS_DATA_PORT/proxy.pac, CA at :$HTTPS_DATA_PORT/ca.pem)"
    if [ -z "$HTTPS_DATA_TOKEN" ]; then
        echo "    (open-LAN data port — set https_data_token to require a shared token)"
    fi
else
    echo "  - HTTPS filter proxy: disabled (https_filter option)"
fi
if [ "$DNS_FILTER" = "true" ]; then
    echo "  - DNS resolver: :$DNS_PORT (UDP+TCP), upstream $DNS_UPSTREAM"
    echo "    point the router's DHCP DNS option at this host for network-wide filtering"
else
    echo "  - DNS resolver: disabled (dns_filter option)"
fi

exec node /app/server.js
