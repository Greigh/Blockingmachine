{
  "name": "blockingmachine-monorepo",
  "version": "1.0.0-rc.8",
  "private": true,
  "description": "High-performance adblock compiler, DNS rule deduplicator, and AI-powered network defense suite for Pi-hole, AdGuard Home, and modern desktops.",
  "license": "BSD-3-Clause",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@blockingmachine/core --workspace=@blockingmachine/system-daemon && npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run --prefix packages/electron-app start",
    "dev": "npm start",
    "package": "npm run --prefix packages/electron-app package",
    "make": "npm run --prefix packages/electron-app make",
    "postinstall": "node scripts/patch-image-size.cjs && node scripts/patch-cross-zip.cjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "verify:mv3": "node scripts/verify-mv3-compliance.mjs",
    "compile:tiers": "node scripts/compile-tier-rulesets.mjs",
    "check:tiers": "node scripts/compile-tier-rulesets.mjs --check",
    "tiers:weekly": "bash scripts/weekly-tier-compile.sh",
    "fit:element-weights": "node scripts/fit-element-weights.mjs --write",
    "check:element-weights": "node scripts/fit-element-weights.mjs --check",
    "derive:vocabulary": "node scripts/derive-tier-vocabulary.mjs --write",
    "check:vocabulary": "node scripts/derive-tier-vocabulary.mjs --check",
    "harvest:elements": "node scripts/harvest-element-candidates.mjs --write",
    "check:element-candidates": "node scripts/harvest-element-candidates.mjs --check",
    "build:hotlist": "node scripts/build-hot-list.mjs --write",
    "measure:hotlist-generalisation": "node scripts/measure-hotlist-generalisation.mjs",
    "ledger:merge": "node scripts/merge-browser-ledger.mjs",
    "check:hotlist": "node scripts/build-hot-list.mjs --check",
    "check:path-decidability": "node scripts/check-path-decidability.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "package:all": "node scripts/package-all.mjs",
    "rehearse:release": "node scripts/release-rehearsal.mjs",
    "publish:npmjs": "node scripts/publish-npmjs.mjs",
    "publish:forgejo": "node scripts/publish-forgejo.mjs",
    "publish:gpr": "node scripts/publish-gpr.mjs"
  },
  "author": {
    "name": "Greigh Studios LLC",
    "email": "daniel@greighstudios.com",
    "url": "https://greighstudios.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greigh/Blockingmachine.git"
  },
  "homepage": "https://github.com/greigh/Blockingmachine",
  "bugs": {
    "url": "https://github.com/greigh/Blockingmachine/issues"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.9.12",
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "extract-zip": "npm:@electron-internal/extract-zip@^1.0.5",
    "image-size": "^2.0.4",
    "@electron-forge/plugin-webpack": {
      "webpack-dev-server": "^5.2.6"
    }
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "fsevents@2.3.3": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "jest@30.4.2": true,
    "electron-winstaller@5.4.4": true
  }
}
